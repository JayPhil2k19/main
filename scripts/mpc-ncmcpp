#!/usr/bin/env bash

# Configuration
PID_FILE="$HOME/.conky-music.pid"
CONKY_CONFIG="$HOME/.config/conky/modules/music"   # ← adjust to your actual config path
POLL_INTERVAL=2     # seconds between checks

# Ensure xdotool is available
if ! command -v xdotool >/dev/null 2>&1; then
    echo "Error: xdotool is required but not installed." >&2
    exit 1
fi

get_active_window_name() {
    xdotool getwindowfocus getwindowname 2>/dev/null || echo ""
}

is_ncmpcpp_focused() {
local name
name=$(xdotool getwindowfocus getwindowname 2>/dev/null) || return 1
			    # Heuristic: title looks like ncmpcpp-managed music playback
	[[ "$$   name" =~ ^[A-Za-z0-9\ ]+[-—][A-Za-z0-9\ ]+\ \[.* $$\.[a-z]{3,4}\]?  \] ||
		"$name" =~ $$   playing   $$ ||
		"$name" =~ \.(mp3|opus|flac|m4a|ogg|mda)\] ]]
	}


is_mpd_playing() {
    mpc status 2>/dev/null | grep -q "^\[playing\]"
}

start_conky() {
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        return  # already running
    fi

    conky -c "$CONKY_CONFIG"  &   # -d = daemonize
    local pid=$!
    echo "$pid" > "$PID_FILE"
    chmod 400 "$PID_FILE"
    echo "Started Conky music module (PID $pid)"
}

stop_conky() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid"
            echo "Stopped Conky music module (PID $pid)"
        fi
        rm -f "$PID_FILE"
    fi
}

main_loop() {
    while true; do
        if is_ncmpcpp_focused && is_mpd_playing; then
            start_conky
        else
            stop_conky
        fi
        sleep "$POLL_INTERVAL"
    done
}

# Cleanup on script exit (Ctrl+C, kill, etc.)
trap 'stop_conky; exit 0' EXIT INT TERM

main_loop
